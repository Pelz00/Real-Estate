# Set a long, random value before deploying.
SECRET_KEY=change-me-in-production

# Optional: defaults to instance/haven.db when omitted.
# DATABASE_URL=sqlite:////absolute/path/to/haven.db

# Optional: Brevo API key from SMTP & API for password-reset emails.
BREVO_API_KEY=
# Optional: a verified sender email in Brevo (falls back to MAIL_USERNAME).
BREVO_SENDER_EMAIL=
