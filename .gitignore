# Environment files and local secrets
.env
.env.*
!.env.example

# Python virtual environments and caches
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.Python

# Local databases and runtime state
instance/
*.db
*.sqlite
*.sqlite3

# Uploaded files (keep the directory placeholder)
app/static/uploads/*
!app/static/uploads/.gitkeep

# Test, coverage, and tooling output
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# IDE and OS files
.DS_Store
.idea/
.vscode/
*.swp

# Local logs and secrets/certificates
*.log
*.pem
